        "note_tweet": {
          "entities": {
            "urls": [
              {
                "display_url": "youtu.be/hDambRVqOp8?si…",
                "end": 693,
                "expanded_url": "https://youtu.be/hDambRVqOp8?si=S4yLTSnGwGxJfl_R",
                "start": 670,
