      },
      {
        "article": {},
        "attachments": {},
        "author_id": "1902568136450424832",
        "conversation_id": "2055647902232662191",
        "created_at": "2026-05-16T13:53:47.000Z",
        "edit_controls": {
          "editable_until": "2026-05-16T14:53:47.000Z",
