      },
      {
        "article": {},
        "attachments": {},
        "author_id": "1778850117933838337",
        "conversation_id": "2043378771227816444",
        "created_at": "2026-04-12T17:20:37.000Z",
        "edit_controls": {
          "editable_until": "2026-04-12T18:20:37.000Z",
          "edits_remaining": 5,
